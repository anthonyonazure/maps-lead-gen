{
  "name": "maps-lead-gen",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop lead generation app for finding, scoring, and exporting Google Maps business leads.",
  "author": "Anthony Clendenen",
  "license": "MIT",
  "main": "electron/main.cjs",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run bundle:server && npm run build -w client",
    "bundle:server": "node scripts/bundle-server.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:build:win": "npm run build && electron-builder --win --publish never",
    "electron:build:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run electron:build:win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "concurrently": "^9.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.0.0",
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
